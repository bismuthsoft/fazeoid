{
  "name": "fmsite-svkit",
  "version": "0.5.1",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#dj-knob/*": "./vendor/svelte-dj-knob/src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-check --tsconfig ./tsconfig.json --config vite.config.js",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --config vite.config.js --watch",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-auto": "^9.0.0",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/audioworklet": "^0.0.102",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-feather-icons": "^4.2.0",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
